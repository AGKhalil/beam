#!/bin/bash
# beam - Session-based SSH tunnel manager with docker-compose port discovery

set -euo pipefail

# --- Colors & Symbols ---
if [[ -t 1 ]]; then
    BOLD='\033[1m'
    DIM='\033[2m'
    RESET='\033[0m'
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    WHITE='\033[0;37m'
    BOLD_WHITE='\033[1;37m'
    BOLD_CYAN='\033[1;36m'
    BOLD_GREEN='\033[1;32m'
    BOLD_RED='\033[1;31m'
    BOLD_YELLOW='\033[1;33m'
else
    BOLD='' DIM='' RESET=''
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' WHITE=''
    BOLD_WHITE='' BOLD_CYAN='' BOLD_GREEN='' BOLD_RED='' BOLD_YELLOW=''
fi

SYM_LIVE="${GREEN}●${RESET}"
SYM_DORMANT="${DIM}○${RESET}"
SYM_DEAD="${RED}●${RESET}"
SYM_OK="${GREEN}✓${RESET}"
SYM_FAIL="${RED}✗${RESET}"
SYM_WARN="${YELLOW}!${RESET}"
SYM_ARROW="${DIM}->${RESET}"
SYM_SKIP="${DIM}—${RESET}"

# --- Output helpers ---
info()  { printf "  ${CYAN}%b${RESET}\n" "$*"; }
ok()    { printf "  ${GREEN}✓${RESET} %b\n" "$*"; }
err()   { printf "  ${RED}✗${RESET} %b\n" "$*" >&2; }
warn()  { printf "  ${YELLOW}!${RESET} %b\n" "$*"; }
hint()  { printf "  ${DIM}%b${RESET}\n" "$*"; }
label() { printf "${BOLD}%b${RESET}\n" "$*"; }

# --- Dependency check ---
if ! command -v jq &>/dev/null; then
    echo ""
    err "jq is required but not installed."
    hint "Install it with: brew install jq"
    echo ""
    exit 1
fi

# --- Constants ---
STATE_DIR="${STATE_DIR:-${HOME}/.local/state/beam}"
STATE_FILE="${STATE_FILE:-${STATE_DIR}/state.json}"

# --- State initialization ---
init_state() {
    if [[ ! -d "$STATE_DIR" ]]; then
        mkdir -p "$STATE_DIR"
    fi
    if [[ ! -f "$STATE_FILE" ]]; then
        echo '{"spaces": {}}' > "$STATE_FILE"
    fi
}

# --- State read/write helpers ---
read_state() {
    local content
    content=$(cat "$STATE_FILE")
    # Validate: must be valid JSON with a .spaces object
    if [[ -z "${content// /}" ]] || ! echo "$content" | jq -e '.spaces' &>/dev/null; then
        warn "State file corrupted, resetting to defaults." >&2
        content='{"spaces": {}}'
        echo "$content" > "$STATE_FILE"
    fi
    echo "$content"
}

write_state() {
    local new_state="$1"
    if ! echo "$new_state" | jq empty 2>/dev/null; then
        err "Refusing to write invalid state (would corrupt state file)."
        return 1
    fi
    echo "$new_state" > "$STATE_FILE"
}

# --- Shared helpers ---

# Validate that a space exists in state. Exits 1 if not found.
require_space() {
    local state="$1" space="$2"
    local exists
    exists=$(echo "$state" | jq -r ".spaces[\"$space\"] // \"null\"")
    if [[ "$exists" == "null" ]]; then
        err "Space '${space}' does not exist."
        exit 1
    fi
}

# Validate that a session exists in a space. Exits 1 if not found.
require_session() {
    local state="$1" space="$2" session="$3"
    local session_data
    session_data=$(echo "$state" | jq -r ".spaces[\"$space\"].sessions[\"$session\"] // \"null\"")
    if [[ "$session_data" == "null" ]]; then
        err "Session '${session}' does not exist in space '${space}'."
        exit 1
    fi
}

# Read core session fields in one jq call. Returns tab-separated:
# host status pid project worktree
# Ports are stored as a JSON array; use read_session_ports() to access them.
# Sessions with old format (no ports array) return empty ports.
read_session() {
    local state="$1" space="$2" session="$3"
    echo "$state" | jq -r ".spaces[\"$space\"].sessions[\"$session\"] |
        [.host, .status, (.pid // \"null\" | tostring), .project, .worktree] | @tsv"
}

# Read a session's ports as a JSON array.
# Returns "[]" for sessions with old format or missing ports.
read_session_ports() {
    local state="$1" space="$2" session="$3"
    echo "$state" | jq -c ".spaces[\"$space\"].sessions[\"$session\"].ports // []"
}

# Get all local ports from a session's ports array as newline-separated list.
read_session_local_ports() {
    local state="$1" space="$2" session="$3"
    echo "$state" | jq -r ".spaces[\"$space\"].sessions[\"$session\"].ports // [] | .[].local"
}

# Kill a session's tunnel and mark it dormant in state.
sleep_session() {
    local space="$1" session="$2"

    local state
    state=$(read_state)
    local s_host s_status s_pid s_project s_worktree
    IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$session")"

    if [[ "$s_status" == "live" && "$s_pid" != "null" ]]; then
        local ports_json
        ports_json=$(read_session_ports "$state" "$space" "$session")
        kill_tunnel "$s_pid" "$ports_json"
    fi

    state=$(read_state)
    state=$(echo "$state" | jq ".spaces[\"$space\"].sessions[\"$session\"].status = \"dormant\" | .spaces[\"$space\"].sessions[\"$session\"].pid = null")
    write_state "$state"
}

# Check for port conflicts and resolve them. Returns 0 if no conflict or resolved, 1 if user cancelled.
# $1 = ports JSON array, $2 = space, $3 = session (to exclude from check)
check_and_resolve_conflicts() {
    local ports_json="$1" space="$2" session="$3"

    local conflict
    conflict=$(find_port_conflicts "$ports_json" "$space" "$session")
    if [[ -n "$conflict" ]]; then
        local state
        state=$(read_state)
        local conflict_space conflict_session
        conflict_space=$(echo "$conflict" | cut -d: -f1)
        conflict_session=$(echo "$conflict" | cut -d: -f2-)
        resolve_conflict "$state" "$conflict_space" "$conflict_session"
        return $?
    fi
    return 0
}

# Activate a session tunnel and print the result.
activate_and_report() {
    local space="$1" session="$2" host="$3" ports_json="$4" success_msg="$5"

    echo ""
    printf "  ${DIM}Connecting...${RESET}"
    if activate_session "$space" "$session" "$host" "$ports_json"; then
        printf "\r\033[K"
        ok "${BOLD}${session}${RESET} ${success_msg}"
        print_ports "$host" "$ports_json"
    else
        printf "\r\033[K"
        err "Failed to start tunnel for ${BOLD}${session}${RESET}."
        hint "Try: beam ${space} up"
    fi
    echo ""
}

# --- Arrow-key selector ---
# Takes lines via stdin (one per option), renders them, lets user
# navigate with arrow keys and confirm with enter.
# Prints the 0-based index of the selected item to stdout.
# Returns 1 if user pressed q/escape with no selection.
arrow_select() {
    declare -a items
    while IFS= read -r line; do
        items+=("$line")
    done

    local count=${#items[@]}
    [[ $count -eq 0 ]] && return 1

    local cur=0

    # Hide cursor, enter raw mode
    printf "\033[?25l" >&2
    # Save tty settings and switch to raw
    local saved_tty
    saved_tty=$(stty -g </dev/tty 2>/dev/null)
    stty -echo -icanon min 1 </dev/tty 2>/dev/null

    # Draw initial list
    _arrow_draw() {
        for i in "${!items[@]}"; do
            if [[ $i -eq $cur ]]; then
                printf "  ${CYAN}>${RESET} %b\n" "${items[$i]}" >&2
            else
                printf "    %b\n" "${items[$i]}" >&2
            fi
        done
    }

    # Move cursor up N lines to redraw
    _arrow_clear() {
        for (( i=0; i<count; i++ )); do
            printf "\033[A\033[2K" >&2
        done
    }

    echo "" >&2
    _arrow_draw

    while true; do
        # Read one byte
        local key
        key=$(dd bs=1 count=1 2>/dev/null </dev/tty)

        case "$key" in
            $'\x1b')
                # Escape sequence — read next two bytes
                local seq1 seq2
                seq1=$(dd bs=1 count=1 2>/dev/null </dev/tty)
                seq2=$(dd bs=1 count=1 2>/dev/null </dev/tty)
                if [[ "$seq1" == "[" ]]; then
                    case "$seq2" in
                        A) # Up
                            if [[ $cur -gt 0 ]]; then
                                cur=$((cur - 1))
                            fi
                            ;;
                        B) # Down
                            if [[ $cur -lt $((count - 1)) ]]; then
                                cur=$((cur + 1))
                            fi
                            ;;
                    esac
                else
                    # Bare escape = cancel
                    _arrow_clear
                    stty "$saved_tty" </dev/tty 2>/dev/null
                    printf "\033[?25h" >&2
                    return 1
                fi
                ;;
            ""|$'\n')
                # Enter = confirm
                _arrow_clear
                # Show final selection
                printf "  ${CYAN}>${RESET} %b\n" "${items[$cur]}" >&2
                stty "$saved_tty" </dev/tty 2>/dev/null
                printf "\033[?25h" >&2
                echo "$cur"
                return 0
                ;;
            q|Q)
                _arrow_clear
                stty "$saved_tty" </dev/tty 2>/dev/null
                printf "\033[?25h" >&2
                return 1
                ;;
            k) # vim up
                if [[ $cur -gt 0 ]]; then
                    cur=$((cur - 1))
                fi
                ;;
            j) # vim down
                if [[ $cur -lt $((count - 1)) ]]; then
                    cur=$((cur + 1))
                fi
                ;;
        esac

        _arrow_clear
        _arrow_draw
    done
}

# --- Session selector ---
select_session() {
    local space="$1"
    local filter="${2:-}"

    local state
    state=$(read_state)

    local sessions
    sessions=$(echo "$state" | jq -r ".spaces[\"$space\"].sessions // {} | keys[]" 2>/dev/null || true)

    if [[ -z "$sessions" ]]; then
        echo ""
        return
    fi

    declare -a candidates
    declare -a display_lines
    while IFS= read -r s; do
        local s_host s_status s_pid s_project s_worktree
        IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$s")"

        if [[ -n "$filter" ]]; then
            [[ "$s_status" != "$filter" ]] && continue
        fi
        candidates+=("$s")

        local indicator
        if [[ "$s_status" == "live" ]]; then
            indicator="${GREEN}●${RESET}"
        else
            indicator="${DIM}○${RESET}"
        fi

        local port_count
        port_count=$(echo "$state" | jq ".spaces[\"$space\"].sessions[\"$s\"].ports // [] | length")
        display_lines+=("$(printf "%b  %-30s ${DIM}%s${RESET}  ${DIM}%d ports${RESET}" \
            "$indicator" "$s" "$s_host" "$port_count")")
    done <<< "$sessions"

    if [[ ${#candidates[@]} -eq 0 ]]; then
        echo ""
        return
    fi

    if [[ ${#candidates[@]} -eq 1 ]]; then
        printf "  ${DIM}auto-selected:${RESET} %s\n" "${candidates[0]}" >&2
        echo "${candidates[0]}"
        return
    fi

    local idx
    if idx=$(printf '%s\n' "${display_lines[@]}" | arrow_select); then
        echo "${candidates[$idx]}"
    else
        echo ""
    fi
}



# --- Compose port discovery ---

# Parse docker-compose.dev.yml port mappings.
# Input: raw compose file content (stdin or $1)
# Output: one line per port: SERVICE|VAR_NAME|DEFAULT|CONTAINER_PORT
#   - VAR_NAME is empty for literal ports
#   - DEFAULT is the fallback value (or the literal host port)
# Skips unrecognized port formats with a warning to stderr.
parse_compose_ports() {
    local compose_content="$1"
    local current_service=""
    local in_ports=false
    local results=""

    while IFS= read -r line; do
        # Detect service name (top-level key under services, 2-space indent)
        if [[ "$line" =~ ^[[:space:]]{2}[a-zA-Z_][a-zA-Z0-9_-]*:[[:space:]]*$ ]]; then
            current_service=$(echo "$line" | sed 's/^[[:space:]]*//' | sed 's/:.*//')
            in_ports=false
            continue
        fi

        # Detect ports: section (4-space indent)
        if [[ "$line" =~ ^[[:space:]]{4}ports:[[:space:]]*$ ]]; then
            in_ports=true
            continue
        fi

        # Exit ports section on any non-list-item at 4+ indent or new section
        if [[ "$in_ports" == true ]]; then
            # Port list items are at 6-space indent with "- "
            if [[ "$line" =~ ^[[:space:]]{6}-[[:space:]] ]]; then
                local port_val
                port_val=$(echo "$line" | sed 's/^[[:space:]]*-[[:space:]]*//' | tr -d '"' | tr -d "'")

                # Pattern 1: ${VAR:-DEFAULT}:CONTAINER
                if [[ "$port_val" =~ ^\$\{([A-Za-z_][A-Za-z0-9_]*):-([0-9]+)\}:([0-9]+)$ ]]; then
                    local var_name="${BASH_REMATCH[1]}"
                    local default_val="${BASH_REMATCH[2]}"
                    results+="${current_service}|${var_name}|${default_val}"$'\n'
                # Pattern 2: LITERAL_HOST:CONTAINER (both numeric)
                elif [[ "$port_val" =~ ^([0-9]+):([0-9]+)$ ]]; then
                    local host_port="${BASH_REMATCH[1]}"
                    results+="${current_service}||${host_port}"$'\n'
                else
                    warn "Skipping unrecognized port format in service '${current_service}': ${port_val}" >&2
                fi
            elif [[ ! "$line" =~ ^[[:space:]]*$ ]]; then
                # Non-empty, non-list-item line = end of ports section
                in_ports=false
            fi
        fi
    done <<< "$compose_content"

    # Output results (strip trailing empty line)
    if [[ -n "$results" ]]; then
        echo "$results" | sed '/^$/d'
    fi
}

# Resolve parsed compose ports against .env to produce JSON array.
# Input: $1 = parsed port lines (from parse_compose_ports), $2 = .env content (may be empty)
# Output: JSON array of [{local, remote, service}]
resolve_ports() {
    local parsed_ports="$1"
    local env_content="${2:-}"

    local json_arr="["
    local first=true

    while IFS='|' read -r service var_name default_val; do
        [[ -z "$service" && -z "$default_val" ]] && continue

        local local_port="$default_val"
        local remote_port="$default_val"

        # If there's a variable name, try to resolve from .env
        if [[ -n "$var_name" && -n "$env_content" ]]; then
            local env_val
            env_val=$(echo "$env_content" | grep "^${var_name}=" | head -1 | cut -d= -f2 | tr -d '[:space:]')
            if [[ -n "$env_val" ]]; then
                remote_port="$env_val"
            fi
        fi

        if [[ "$first" == true ]]; then
            first=false
        else
            json_arr+=","
        fi
        json_arr+="{\"local\":${local_port},\"remote\":${remote_port},\"service\":\"${service}\"}"
    done <<< "$parsed_ports"

    json_arr+="]"
    echo "$json_arr"
}

# --- Tunnel core ---

start_tunnel() {
    local host="$1"
    local ports_json="$2"

    # Build -L flags dynamically
    local ssh_args=()
    ssh_args+=(-fN -o ServerAliveInterval=30 -o ServerAliveCountMax=3)

    local first_local=""
    while IFS=$'\t' read -r local_port remote_port; do
        ssh_args+=(-L "${local_port}:localhost:${remote_port}")
        [[ -z "$first_local" ]] && first_local="$local_port"
    done < <(echo "$ports_json" | jq -r '.[] | [(.local|tostring), (.remote|tostring)] | @tsv')

    ssh_args+=("$host")

    local ssh_exit=0
    ssh "${ssh_args[@]}" 2>/dev/null || ssh_exit=$?

    if [[ "$ssh_exit" -ne 0 ]]; then
        echo ""
        return 1
    fi

    sleep 0.5

    local pid
    pid=$(pgrep -n -f "ssh.*-L ${first_local}:localhost:.*${host}" 2>/dev/null || true)

    if [[ -z "$pid" ]]; then
        echo ""
        return 1
    fi

    # Verify all local forwards are actually listening
    while IFS= read -r lp; do
        if ! lsof -i ":${lp}" -sTCP:LISTEN &>/dev/null; then
            kill "$pid" 2>/dev/null || true
            echo ""
            return 1
        fi
    done < <(echo "$ports_json" | jq -r '.[].local')

    echo "$pid"
}

kill_tunnel() {
    local pid="$1"
    local ports_json="${2:-[]}"

    if [[ -z "$pid" || "$pid" == "null" ]]; then
        return 0
    fi

    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        local i=0
        while kill -0 "$pid" 2>/dev/null && [[ $i -lt 30 ]]; do
            sleep 0.1
            ((i++))
        done
    fi

    # Wait for each local port to release
    while IFS= read -r lp; do
        [[ -z "$lp" ]] && continue
        local i=0
        while lsof -i ":${lp}" -sTCP:LISTEN &>/dev/null && [[ $i -lt 30 ]]; do
            sleep 0.1
            ((i++))
        done
    done < <(echo "$ports_json" | jq -r '.[].local // empty')
}

check_health() {
    local pid="$1"
    local ports_json="$2"

    if [[ -z "$pid" || "$pid" == "null" ]] || ! kill -0 "$pid" 2>/dev/null; then
        echo "dead"
        return
    fi

    while IFS= read -r lp; do
        [[ -z "$lp" ]] && continue
        if ! lsof -i ":${lp}" -sTCP:LISTEN &>/dev/null; then
            echo "dead"
            return
        fi
    done < <(echo "$ports_json" | jq -r '.[].local // empty')

    echo "healthy"
}

find_port_conflicts() {
    local target_ports_json="$1"
    local exclude_space="${2:-}"
    local exclude_session="${3:-}"

    # Build a lookup of target local ports
    local target_ports
    target_ports=$(echo "$target_ports_json" | jq -r '.[].local')

    local state
    state=$(read_state)

    local spaces
    spaces=$(echo "$state" | jq -r '.spaces | keys[]' 2>/dev/null || true)

    for space in $spaces; do
        local sessions
        sessions=$(echo "$state" | jq -r ".spaces[\"$space\"].sessions // {} | keys[]" 2>/dev/null || true)
        for session in $sessions; do
            if [[ "$space" == "$exclude_space" && "$session" == "$exclude_session" ]]; then
                continue
            fi

            local s_host s_status s_pid s_project s_worktree
            IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$session")"

            if [[ "$s_status" != "live" ]]; then
                continue
            fi

            local existing_ports
            existing_ports=$(read_session_local_ports "$state" "$space" "$session")

            # Check for any overlap
            for tp in $target_ports; do
                for ep in $existing_ports; do
                    if [[ "$tp" == "$ep" ]]; then
                        echo "${space}:${session}"
                        return
                    fi
                done
            done
        done
    done
}

# Helper: resolve port conflict (sleep the conflicting session)
# Returns 0 if resolved, 1 if user cancelled
resolve_conflict() {
    local state="$1"
    local conflict_space="$2"
    local conflict_session="$3"

    echo ""
    warn "Port conflict with ${BOLD}${conflict_session}${RESET} ${DIM}(${conflict_space})${RESET}"
    printf "  Tear it down? ${DIM}(y/N)${RESET} "
    read -r answer </dev/tty
    if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
        sleep_session "$conflict_space" "$conflict_session"
        printf "  ${DIM}○${RESET} %s torn down\n" "$conflict_session"
        return 0
    else
        hint "Cancelled."
        return 1
    fi
}

# Helper: start tunnel and update state
# Prints result line. Returns 0 on success, 1 on failure.
activate_session() {
    local space="$1"
    local session="$2"
    local host="$3"
    local ports_json="$4"

    local raw_pid=""
    raw_pid=$(start_tunnel "$host" "$ports_json" 2>/dev/null) || true

    # Sanitize: extract only the numeric PID (strip any SSH warnings that leaked into stdout)
    local pid=""
    pid=$(echo "$raw_pid" | grep -E '^[0-9]+$' | tail -1)

    if [[ -n "$pid" ]]; then
        local state
        state=$(read_state)
        state=$(echo "$state" | jq ".spaces[\"$space\"].sessions[\"$session\"].status = \"live\" | .spaces[\"$space\"].sessions[\"$session\"].pid = $pid")
        write_state "$state"
        return 0
    else
        return 1
    fi
}

# Helper: print port mapping lines from ports JSON array
print_ports() {
    local host="$1" ports_json="$2"
    while IFS=$'\t' read -r local_port remote_port service; do
        printf "  ${DIM}localhost${RESET}:${BOLD_WHITE}%s${RESET} ${SYM_ARROW} %s:${DIM}%s${RESET}  ${DIM}(%s)${RESET}\n" "$local_port" "$host" "$remote_port" "$service"
    done < <(echo "$ports_json" | jq -r '.[] | [(.local|tostring), (.remote|tostring), .service] | @tsv')
}

# --- Space host memory ---

# Get known hosts for a space. Returns JSON array (empty if missing).
get_space_hosts() {
    local state="$1" space="$2"
    echo "$state" | jq -c ".spaces[\"$space\"].hosts // []"
}

# Add a host to a space's known hosts (no-op if already present).
add_space_host() {
    local space="$1" host="$2"
    local state
    state=$(read_state)
    state=$(echo "$state" | jq "
        .spaces[\"$space\"].hosts = ((.spaces[\"$space\"].hosts // []) + [\"$host\"] | unique)
    ")
    write_state "$state"
}

# --- Space management ---

cmd_space_ls() {
    local state
    state=$(read_state)
    local spaces
    spaces=$(echo "$state" | jq -r '.spaces | keys[]' 2>/dev/null || true)

    if [[ -z "$spaces" ]]; then
        echo ""
        hint "No spaces yet."
        hint "Create one: ${BOLD}beam space create <name>${RESET}"
        echo ""
        return
    fi

    echo ""
    while IFS= read -r s; do
        local count
        count=$(echo "$state" | jq ".spaces[\"$s\"].sessions | length")
        printf "  ${BOLD_WHITE}%s${RESET}  ${DIM}(%d sessions)${RESET}\n" "$s" "$count"
    done <<< "$spaces"
    echo ""
}

cmd_space_create() {
    local name="$1"

    if [[ -z "$name" ]]; then
        err "Missing name"
        hint "Usage: beam space create <name>"
        exit 1
    fi

    local state
    state=$(read_state)

    local exists
    exists=$(echo "$state" | jq -r ".spaces[\"$name\"] // \"null\"")
    if [[ "$exists" != "null" ]]; then
        err "Space '${name}' already exists."
        exit 1
    fi

    state=$(echo "$state" | jq ".spaces[\"$name\"] = {\"hosts\": [], \"sessions\": {}}")
    write_state "$state"
    echo ""
    ok "Space ${BOLD}${name}${RESET} created"
    echo ""
}

cmd_space_rm() {
    local name="$1"
    local force="${2:-}"

    if [[ -z "$name" ]]; then
        err "Missing name"
        hint "Usage: beam space rm <name> [--force]"
        exit 1
    fi

    local state
    state=$(read_state)
    require_space "$state" "$name"

    local session_count
    session_count=$(echo "$state" | jq ".spaces[\"$name\"].sessions | length")

    if [[ "$session_count" -gt 0 && "$force" != "--force" ]]; then
        err "Space '${name}' has ${session_count} session(s)."
        hint "Use --force to remove."
        exit 1
    fi

    if [[ "$session_count" -gt 0 && "$force" == "--force" ]]; then
        local sessions
        sessions=$(echo "$state" | jq -r ".spaces[\"$name\"].sessions | keys[]" 2>/dev/null || true)
        for session in $sessions; do
            local s_host s_status s_pid s_project s_worktree
            IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$name" "$session")"
            if [[ "$s_status" == "live" && "$s_pid" != "null" ]]; then
                local ports_json
                ports_json=$(read_session_ports "$state" "$name" "$session")
                kill_tunnel "$s_pid" "$ports_json"
                printf "  ${DIM}○${RESET} killed %s\n" "$session"
            fi
        done
    fi

    state=$(read_state)
    state=$(echo "$state" | jq "del(.spaces[\"$name\"])")
    write_state "$state"
    echo ""
    ok "Space ${BOLD}${name}${RESET} removed"
    echo ""
}

# --- Session lifecycle ---

cmd_session_create() {
    local space="$1"

    local state
    state=$(read_state)
    require_space "$state" "$space"

    # Host selection: offer known hosts or prompt for new
    local known_hosts_json
    known_hosts_json=$(get_space_hosts "$state" "$space")
    local known_count
    known_count=$(echo "$known_hosts_json" | jq 'length')

    local host=""
    if [[ "$known_count" -eq 0 ]]; then
        # No known hosts — raw prompt
        echo ""
        printf "  ${BOLD}SSH host${RESET} ${DIM}(e.g. ag@hetzner1)${RESET}: "
        read -r host
    else
        # Known hosts — arrow select with "new host" option
        echo ""
        label "  SSH host"

        declare -a host_arr host_display
        while IFS= read -r h; do
            host_arr+=("$h")
            host_display+=("$h")
        done < <(echo "$known_hosts_json" | jq -r '.[]')

        host_arr+=("__new__")
        host_display+=("${DIM}+ Enter a new host...${RESET}")

        local host_idx
        if host_idx=$(printf '%s\n' "${host_display[@]}" | arrow_select); then
            if [[ "${host_arr[$host_idx]}" == "__new__" ]]; then
                printf "  ${BOLD}SSH host${RESET} ${DIM}(e.g. ag@hetzner1)${RESET}: "
                read -r host
            else
                host="${host_arr[$host_idx]}"
            fi
        fi
    fi

    if [[ -z "$host" ]]; then
        err "SSH host is required."
        exit 1
    fi

    local short_host
    short_host=$(echo "$host" | sed 's/.*@//')

    printf "  ${DIM}Scanning %s...${RESET}" "$host"
    local dirlist
    dirlist=$(ssh -o ConnectTimeout=10 -o ClearAllForwardings=yes "$host" 'ls -1d ~/codebases/*/ 2>/dev/null | while read d; do basename "$d"; done | sort' 2>/dev/null)
    printf "\r\033[K"

    if [[ -z "$dirlist" ]]; then
        err "No projects found in ~/codebases on ${host}."
        exit 1
    fi

    declare -a proj_arr
    while IFS= read -r dir; do
        if [[ "$dir" == *"."* ]]; then
            local base="${dir%%.*}"
            if echo "$dirlist" | grep -qx "$base"; then
                continue
            fi
        fi
        proj_arr+=("$dir")
    done <<< "$dirlist"

    echo ""
    label "  Projects"

    declare -a proj_display
    for proj in "${proj_arr[@]}"; do
        local count=0
        while IFS= read -r dir; do
            if [[ "$dir" == "${proj}."* ]]; then
                count=$((count + 1))
            fi
        done <<< "$dirlist"

        if [[ "$count" -gt 0 ]]; then
            proj_display+=("$(printf "%-25s ${DIM}%d worktrees${RESET}" "$proj" "$count")")
        else
            proj_display+=("$proj")
        fi
    done

    local project=""
    if [[ ${#proj_arr[@]} -eq 1 ]]; then
        project="${proj_arr[0]}"
    else
        local proj_idx
        if proj_idx=$(printf '%s\n' "${proj_display[@]}" | arrow_select); then
            project="${proj_arr[$proj_idx]}"
        fi
    fi
    if [[ -z "$project" ]]; then
        hint "No project selected."
        exit 1
    fi

    declare -a wt_arr
    while IFS= read -r dir; do
        if [[ "$dir" == "${project}."* ]]; then
            wt_arr+=("$dir")
        fi
    done <<< "$dirlist"

    if [[ ${#wt_arr[@]} -eq 0 ]]; then
        err "No worktrees found for ${project}."
        exit 1
    fi

    # Preview: count services from compose files
    local count_cmd=""
    for wt in "${wt_arr[@]}"; do
        count_cmd="${count_cmd}echo \"${wt}|\$(grep -c '^\\ \\{6\\}- ' ~/codebases/${wt}/docker-compose.dev.yml 2>/dev/null || echo 0)\";"
    done
    local wt_counts
    wt_counts=$(ssh -o ConnectTimeout=10 -o ClearAllForwardings=yes "$host" "$count_cmd" 2>/dev/null)

    echo ""
    label "  Worktrees"

    declare -a wt_values wt_display
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local wt svc_count
        wt=$(echo "$line" | cut -d'|' -f1)
        svc_count=$(echo "$line" | cut -d'|' -f2 | tr -d '[:space:]')
        wt_values+=("$wt")
        if [[ "$svc_count" -gt 0 ]]; then
            wt_display+=("$(printf "%-30s ${DIM}%s services${RESET}" "$wt" "$svc_count")")
        else
            wt_display+=("$(printf "%-30s ${DIM}no compose${RESET}" "$wt")")
        fi
    done <<< "$wt_counts"

    local worktree=""
    if [[ ${#wt_values[@]} -eq 1 ]]; then
        worktree="${wt_values[0]}"
    else
        local wt_idx
        if wt_idx=$(printf '%s\n' "${wt_display[@]}" | arrow_select); then
            worktree="${wt_values[$wt_idx]}"
        fi
    fi
    if [[ -z "$worktree" ]]; then
        hint "No worktree selected."
        exit 1
    fi

    # Read compose file and .env from remote in one SSH call
    local remote_data
    remote_data=$(ssh -o ConnectTimeout=10 -o ClearAllForwardings=yes "$host" "
        echo '===COMPOSE==='
        cat ~/codebases/$worktree/docker-compose.dev.yml 2>/dev/null || echo '===NO_COMPOSE==='
        echo '===ENV==='
        cat ~/codebases/$worktree/.env 2>/dev/null || echo ''
    " 2>/dev/null)

    local compose_content env_content
    compose_content=$(echo "$remote_data" | sed -n '/^===COMPOSE===/,/^===ENV===/p' | sed '1d;$d')
    env_content=$(echo "$remote_data" | sed -n '/^===ENV===/,$p' | sed '1d')

    if [[ "$compose_content" == "===NO_COMPOSE===" || -z "$compose_content" ]]; then
        err "No docker-compose.dev.yml found in ~/codebases/${worktree}/"
        exit 1
    fi

    local parsed_ports
    parsed_ports=$(parse_compose_ports "$compose_content")

    if [[ -z "$parsed_ports" ]]; then
        err "No port mappings found in docker-compose.dev.yml"
        exit 1
    fi

    local ports_json
    ports_json=$(resolve_ports "$parsed_ports" "$env_content")

    local port_count
    port_count=$(echo "$ports_json" | jq 'length')

    echo ""
    printf "  ${DIM}Discovered %d port mappings:${RESET}\n" "$port_count"
    while IFS=$'\t' read -r lp rp svc; do
        printf "    ${DIM}%s${RESET}: localhost:${BOLD_WHITE}%s${RESET} ${SYM_ARROW} %s:${DIM}%s${RESET}\n" "$svc" "$lp" "$host" "$rp"
    done < <(echo "$ports_json" | jq -r '.[] | [(.local|tostring), (.remote|tostring), .service] | @tsv')

    local session_name="${short_host}:${worktree}"

    local session_exists
    session_exists=$(echo "$state" | jq -r ".spaces[\"$space\"].sessions[\"$session_name\"] // \"null\"")
    if [[ "$session_exists" != "null" ]]; then
        echo ""
        warn "Session '${session_name}' already exists in space '${space}'."
        printf "  Replace it? ${DIM}(y/n)${RESET} "
        read -r answer </dev/tty
        if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
            sleep_session "$space" "$session_name"
            state=$(read_state)
            state=$(echo "$state" | jq "del(.spaces[\"$space\"].sessions[\"$session_name\"])")
            write_state "$state"
            printf "  ${DIM}○${RESET} old session removed\n"
        else
            hint "Cancelled."
            exit 0
        fi
    fi

    # Check for port conflicts
    check_and_resolve_conflicts "$ports_json" "$space" "$session_name" || exit 0

    # Create session in state
    state=$(read_state)
    local ports_for_jq
    ports_for_jq=$(echo "$ports_json" | jq -c '.')
    state=$(echo "$state" | jq --argjson ports "$ports_for_jq" ".spaces[\"$space\"].sessions[\"$session_name\"] = {
        \"host\": \"$host\",
        \"project\": \"$project\",
        \"worktree\": \"$worktree\",
        \"ports\": \$ports,
        \"status\": \"dormant\",
        \"pid\": null
    }")
    write_state "$state"

    # Remember this host for future sessions in this space
    add_space_host "$space" "$host"

    activate_and_report "$space" "$session_name" "$host" "$ports_json" "created and live"
}

cmd_session_ls() {
    local space="$1"

    local state
    state=$(read_state)
    require_space "$state" "$space"

    local sessions
    sessions=$(echo "$state" | jq -r ".spaces[\"$space\"].sessions // {} | keys[]" 2>/dev/null || true)

    if [[ -z "$sessions" ]]; then
        echo ""
        hint "No sessions in ${BOLD}${space}${RESET}."
        hint "Create one: ${BOLD}beam ${space} create${RESET}"
        echo ""
        return
    fi

    echo ""
    printf "  ${DIM}%-2s  %-32s %-18s %-10s %s${RESET}\n" "" "SESSION" "HOST" "PORTS" "STATUS"
    echo ""

    while IFS= read -r session; do
        local s_host s_status s_pid s_project s_worktree
        IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$session")"

        local indicator status_str port_count
        port_count=$(echo "$state" | jq ".spaces[\"$space\"].sessions[\"$session\"].ports // [] | length")

        if [[ "$s_status" == "live" ]]; then
            indicator="${GREEN}●${RESET}"
            status_str="${GREEN}live${RESET}"
        else
            indicator="${DIM}○${RESET}"
            status_str="${DIM}dormant${RESET}"
        fi

        printf "  %b  %-32s ${DIM}%-18s${RESET} %-10s %b\n" "$indicator" "$session" "$s_host" "${port_count} ports" "$status_str"
    done <<< "$sessions"
    echo ""
}

# Shared implementation for up/switch commands.
# $5 = auto_resolve: if "true", automatically sleep conflicting sessions without prompting
cmd_session_activate() {
    local space="$1"
    local session="${2:-}"
    local success_msg="${3:-is live}"
    local selector_label="${4:-Activate session}"
    local auto_resolve="${5:-false}"

    if [[ -z "$session" ]]; then
        printf "\n  ${BOLD}%s${RESET} ${DIM}(${space})${RESET}\n" "$selector_label"
        session=$(select_session "$space" "dormant")
        if [[ -z "$session" ]]; then
            hint "No dormant sessions."
            echo ""
            return
        fi
    fi

    local state
    state=$(read_state)
    require_space "$state" "$space"
    require_session "$state" "$space" "$session"

    local s_host s_status s_pid s_project s_worktree
    IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$session")"

    if [[ "$s_status" == "live" ]]; then
        echo ""
        hint "Already live."
        echo ""
        return
    fi

    local ports_json
    ports_json=$(read_session_ports "$state" "$space" "$session")

    if [[ "$auto_resolve" == "true" ]]; then
        # Auto-sleep any conflicting session (used by switch)
        local conflict
        conflict=$(find_port_conflicts "$ports_json" "$space" "$session")
        if [[ -n "$conflict" ]]; then
            local conflict_space conflict_session
            conflict_space=$(echo "$conflict" | cut -d: -f1)
            conflict_session=$(echo "$conflict" | cut -d: -f2-)
            sleep_session "$conflict_space" "$conflict_session"
            echo ""
            printf "  ${DIM}○${RESET} %s slept\n" "$conflict_session"
        fi
    else
        check_and_resolve_conflicts "$ports_json" "$space" "$session" || return
    fi

    activate_and_report "$space" "$session" "$s_host" "$ports_json" "$success_msg"
}

cmd_session_up() {
    cmd_session_activate "$1" "${2:-}" "is live" "Activate session"
}

cmd_session_down() {
    local space="$1"
    local session="${2:-}"

    if [[ -z "$session" ]]; then
        printf "\n  ${BOLD}Sleep session${RESET} ${DIM}(${space})${RESET}\n"
        session=$(select_session "$space" "live")
        if [[ -z "$session" ]]; then
            hint "No live sessions."
            echo ""
            return
        fi
    fi

    local state
    state=$(read_state)
    require_space "$state" "$space"
    require_session "$state" "$space" "$session"

    local s_host s_status s_pid s_project s_worktree
    IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$session")"

    if [[ "$s_status" == "dormant" ]]; then
        echo ""
        hint "Already dormant."
        echo ""
        return
    fi

    sleep_session "$space" "$session"
    echo ""
    printf "  ${DIM}○${RESET} ${BOLD}%s${RESET} slept\n" "$session"
    echo ""
}

cmd_session_rm() {
    local space="$1"
    local session="${2:-}"

    if [[ -z "$session" ]]; then
        printf "\n  ${BOLD}Remove session${RESET} ${DIM}(${space})${RESET}\n"
        session=$(select_session "$space")
        if [[ -z "$session" ]]; then
            hint "No sessions."
            echo ""
            return
        fi
    fi

    local state
    state=$(read_state)
    require_space "$state" "$space"
    require_session "$state" "$space" "$session"

    local s_host s_status s_pid s_project s_worktree
    IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$session")"

    if [[ "$s_status" == "live" && "$s_pid" != "null" ]]; then
        local ports_json
        ports_json=$(read_session_ports "$state" "$space" "$session")
        kill_tunnel "$s_pid" "$ports_json"
    fi

    state=$(read_state)
    state=$(echo "$state" | jq "del(.spaces[\"$space\"].sessions[\"$session\"])")
    write_state "$state"
    echo ""
    ok "${BOLD}${session}${RESET} removed"
    echo ""
}

cmd_session_switch() {
    cmd_session_activate "$1" "${2:-}" "Switched to" "Switch session" "true"
}

# --- Dashboard ---

cmd_dashboard() {
    local state
    state=$(read_state)

    local spaces
    spaces=$(echo "$state" | jq -r '.spaces | keys[]' 2>/dev/null || true)

    if [[ -z "$spaces" ]]; then
        echo ""
        printf "  ${BOLD_CYAN}beam${RESET}\n"
        echo ""
        hint "No spaces yet."
        hint "Create one: ${BOLD}beam space create <name>${RESET}"
        echo ""
        return
    fi

    local has_dead=false

    echo ""
    printf "  ${BOLD_CYAN}beam${RESET}\n"

    while IFS= read -r space; do
        echo ""
        printf "  ${BOLD_WHITE}%s${RESET}\n" "$space"

        local sessions
        sessions=$(echo "$state" | jq -r ".spaces[\"$space\"].sessions // {} | keys[]" 2>/dev/null || true)

        if [[ -z "$sessions" ]]; then
            hint "  (empty)"
            continue
        fi

        while IFS= read -r session; do
            local s_host s_status s_pid s_project s_worktree
            IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$session")"
            local ports_json
            ports_json=$(read_session_ports "$state" "$space" "$session")
            local port_count
            port_count=$(echo "$ports_json" | jq 'length')

            if [[ "$s_status" == "live" ]]; then
                local health
                health=$(check_health "$s_pid" "$ports_json")
                if [[ "$health" == "healthy" ]]; then
                    printf "  ${GREEN}●${RESET}  %-32s ${DIM}%s${RESET}  ${DIM}%d ports${RESET}  ${GREEN}healthy${RESET}\n" \
                        "$session" "$s_host" "$port_count"
                else
                    has_dead=true
                    printf "  ${RED}●${RESET}  %-32s ${DIM}%s${RESET}  ${DIM}%d ports${RESET}  ${BOLD_RED}DEAD${RESET}\n" \
                        "$session" "$s_host" "$port_count"
                fi
            else
                printf "  ${DIM}○${RESET}  ${DIM}%-32s %s${RESET}\n" "$session" "$s_host"
            fi
        done <<< "$sessions"
    done <<< "$spaces"

    if [[ "$has_dead" == true ]]; then
        echo ""
        warn "Dead tunnels detected. Run ${BOLD}beam hydrate${RESET}"
    fi
    echo ""
}

# --- Hydrate ---

cmd_hydrate() {
    local state
    state=$(read_state)

    local spaces
    spaces=$(echo "$state" | jq -r '.spaces | keys[]' 2>/dev/null || true)

    if [[ -z "$spaces" ]]; then
        hint "No spaces exist."
        return
    fi

    local found_live=false
    local hydrated_ports=()

    echo ""
    label "  Hydrating"
    echo ""

    while IFS= read -r space; do
        local sessions
        sessions=$(echo "$state" | jq -r ".spaces[\"$space\"].sessions // {} | keys[]" 2>/dev/null || true)
        [[ -z "$sessions" ]] && continue

        while IFS= read -r session; do
            local s_host s_status s_pid s_project s_worktree
            IFS=$'\t' read -r s_host s_status s_pid s_project s_worktree <<< "$(read_session "$state" "$space" "$session")"

            [[ "$s_status" != "live" ]] && continue

            found_live=true

            local ports_json
            ports_json=$(read_session_ports "$state" "$space" "$session")

            local health
            health=$(check_health "$s_pid" "$ports_json")

            if [[ "$health" == "healthy" ]]; then
                printf "  ${GREEN}●${RESET}  %s  ${DIM}already healthy${RESET}\n" "$session"
                continue
            fi

            local port_conflict=false
            local session_local_ports
            session_local_ports=$(echo "$ports_json" | jq -r '.[].local')
            for slp in $session_local_ports; do
                for hp in "${hydrated_ports[@]:-}"; do
                    if [[ "$hp" == "$slp" ]]; then
                        port_conflict=true
                        break 2
                    fi
                done
            done

            if [[ "$port_conflict" == true ]]; then
                printf "  ${YELLOW}!${RESET}  %s  ${DIM}skipped (port conflict)${RESET}\n" "$session"
                continue
            fi

            if [[ "$s_pid" != "null" ]]; then
                kill_tunnel "$s_pid" "$ports_json"
            fi

            printf "  ${DIM}…${RESET}  %s  ${DIM}reconnecting${RESET}" "$session"
            if activate_session "$space" "$session" "$s_host" "$ports_json"; then
                while IFS= read -r lp; do
                    hydrated_ports+=("$lp")
                done < <(echo "$ports_json" | jq -r '.[].local')
                printf "\r\033[K  ${GREEN}●${RESET}  %s  ${GREEN}reconnected${RESET}\n" "$session"
            else
                printf "\r\033[K  ${RED}✗${RESET}  %s  ${RED}failed${RESET}\n" "$session"
            fi
        done <<< "$sessions"
    done <<< "$spaces"

    if [[ "$found_live" == false ]]; then
        hint "No live sessions to hydrate."
    fi
    echo ""
}

# --- Usage ---

show_usage() {
    echo ""
    printf "  ${BOLD_CYAN}beam${RESET} ${DIM}- SSH tunnel manager${RESET}\n"
    echo ""
    printf "  ${BOLD}Usage${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET}                            ${DIM}Dashboard${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET} space ls|create|rm         ${DIM}Manage spaces${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET} <space> create              ${DIM}New session (interactive)${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET} <space> ls                  ${DIM}List sessions${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET} <space> up    ${DIM}[session]${RESET}     ${DIM}Activate session${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET} <space> down  ${DIM}[session]${RESET}     ${DIM}Sleep session${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET} <space> switch ${DIM}[session]${RESET}    ${DIM}Switch (sleep conflicts)${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET} <space> rm    ${DIM}[session]${RESET}     ${DIM}Remove session${RESET}\n"
    printf "    ${BOLD_WHITE}beam${RESET} hydrate                     ${DIM}Reconnect dead tunnels${RESET}\n"
    echo ""
}

# --- Subcommand routing ---

# Guard: skip main execution when sourced (for testing)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then

init_state

case "${1:-}" in
    "")
        cmd_dashboard
        ;;
    help|--help|-h)
        show_usage
        ;;
    space|spaces)
        case "${2:-}" in
            ls)
                cmd_space_ls
                ;;
            create)
                cmd_space_create "${3:-}"
                ;;
            rm)
                cmd_space_rm "${3:-}" "${4:-}"
                ;;
            *)
                show_usage
                exit 1
                ;;
        esac
        ;;
    hydrate)
        cmd_hydrate
        ;;
    *)
        local_space="$1"
        local_action="${2:-}"
        local_session="${3:-}"

        case "$local_action" in
            create)
                cmd_session_create "$local_space"
                ;;
            ls)
                cmd_session_ls "$local_space"
                ;;
            up)
                cmd_session_up "$local_space" "$local_session"
                ;;
            down)
                cmd_session_down "$local_space" "$local_session"
                ;;
            rm)
                cmd_session_rm "$local_space" "$local_session"
                ;;
            switch)
                cmd_session_switch "$local_space" "$local_session"
                ;;
        *)
            show_usage
            exit 1
            ;;
    esac
    ;;
esac

fi # end source guard
